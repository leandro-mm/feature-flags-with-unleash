{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FeatureFlag.API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/FeatureFlag.API/bin/Debug/net10.0/FeatureFlag.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FeatureFlag.API",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "EBird__ApiKey": ""
            },
            "serverReadyAction": {
                "pattern": "Now listening on: (https?://\\S+)",
                "action": "openExternally",
                "uriFormat": "%s"
            }
        },
        {
            "name": "Launch FeatureFlag.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/FeatureFlag.Web/bin/Debug/net8.0/FeatureFlag.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FeatureFlag.Web",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "EBird__ApiKey": ""
            },
            "serverReadyAction": {
                "pattern": "Now listening on: (https?://\\S+)",
                "action": "openExternally",
                "uriFormat": "%s"
            }
        }
    ],
    "compounds": [
        {
            "name": "Launch API + Web",
            "configurations": ["Launch FeatureFlag.API", "Launch FeatureFlag.Web"]
        }
    ]
}