@page "/"
@rendermode InteractiveServer
@inject ApiService ApiService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<div>
    <span class="text-muted">Click the button below to call the API endpoint and get the weather forecast by longitude
        and latitude.</span>
        <button class="btn btn-sm btn-info" @onclick="() => CallMyEndpoint()">
            Get
        </button>
    </div>

Welcome to your new app.
@code {
    private async Task CallMyEndpoint()
    {
        var requestData = new
        {
            Longitude = -122.4194,
            Latitude = 37.7749,
            UserName = "JohnDoe"
        };

        var data = await ApiService.PostAsync<WeatherForecastDto>("/weatherforecast/longlat", requestData);
        Console.WriteLine($"Weather Forecast: {data.Summary}, {data.TemperatureC}°C");
    }
}